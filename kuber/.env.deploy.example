# Settings of the deploy scripts: apply-all.sh, setup-in-k3d.sh and
# project/kustomize/release.sh. They take no arguments, everything comes from
# here.
#
# The file is read as KEY=value, not sourced: shell expansions do not work and
# a value cannot contain a "#", but a typo here can no longer move the scripts
# around. Surrounding quotes, inline comments and CRLF endings are stripped.
#
# Copy it and fill in the values, the copy is gitignored:
#
#   cp .env.deploy.example .env.deploy
#
# The image tag is deliberately NOT here. It lives in git, in
# project/kustomize/overlays/<environment>/kustomization.yaml, and is bumped
# by "project/kustomize/release.sh version", which takes it from build.gradle.

# Docker hub user the images were pushed under, the same one docker-compose
# reads from DOCKER_HUB_USER. Leave it empty to use the images as they are,
# which is what locally built k3d images need.
DOCKER_HUB_USER=

# Registry host. Ignored while DOCKER_HUB_USER is empty.
REGISTRY_HOST=docker.io

# Which overlay of project/kustomize/overlays is deployed:
# production, dev or test.
ENVIRONMENT=production

# kustomize - the default deploy.
# plain     - the pre kustomize flow: kubectl apply -f project/<folder>,
#             needs release.sh to have generated project/deployments first.
#             Production only: those manifests carry the hostPath
#             PersistentVolumes, which are shared by the whole cluster.
DEPLOY_MODE=kustomize

# Name of the k3d cluster setup-in-k3d.sh creates.
K3D_CLUSTER=my-cluster
